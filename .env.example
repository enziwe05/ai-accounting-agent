# Copy this file to ".env" and fill in your real values.
# The .env file is git-ignored and must never be committed.

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Models: MODEL is the CFO agent's brain; READ_MODEL reads receipts (cheaper).
# The defaults are good — only set these to override.
# MODEL=claude-opus-4-8
# READ_MODEL=claude-haiku-4-5

# --- Business (prints on invoices; each company sets its own) ---
# Home currency (South Africa = ZAR). Detected currency on a document still wins.
DEFAULT_CURRENCY=ZAR
BUSINESS_NAME=Your Business (Pty) Ltd
BUSINESS_EMAIL=hello@yourbusiness.co.za
BUSINESS_PHONE=+27 82 000 0000
BUSINESS_ADDRESS=
BUSINESS_VAT_NO=
# Banking lines for the invoice PDF, separated by a pipe "|".
BUSINESS_BANK_DETAILS=Bank name|Acc: 000000000|Branch: 000000|Ref: your invoice number

# --- Database (local development = MAMP's MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=bookkeeper

# --- WhatsApp (Meta Cloud API) ---
# From Meta: WhatsApp > API Setup. The token is a SECRET — never commit it.
WHATSAPP_TOKEN=paste-your-meta-access-token-here
WHATSAPP_PHONE_NUMBER_ID=paste-your-phone-number-id-here
# A secret string YOU invent; you enter the SAME value in Meta's webhook config.
WHATSAPP_VERIFY_TOKEN=change-me-to-a-secret-string
# REQUIRED FOR PRODUCTION: your Meta App Secret. When set, the webhook verifies
# Meta's signature on every incoming request, rejecting forged messages.
WHATSAPP_APP_SECRET=

# --- Security (set these before going live) ---
# Approved owner WhatsApp number(s) that may control the bot — comma-separated,
# digits with country code. If left blank, ANY sender can use the bot (dev only).
# Example: OWNER_NUMBERS=27821234567,27829998888
OWNER_NUMBERS=
# Max messages one sender may send per minute before a brief cooldown (default 20).
RATE_LIMIT_PER_MINUTE=20
