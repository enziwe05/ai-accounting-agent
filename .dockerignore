# Keep the image small and secrets/junk out of it.
.venv/
venv/
.git/
.gitignore
__pycache__/
*.pyc
.pytest_cache/

# Secrets and per-company config live in env files mounted at runtime, never baked
# into the image.
.env
env/

# Runtime data and generated files (mounted as volumes on the server instead).
uploads/
reports/
data/*
backups/
# ...but DO bake in the seed packs (category/rule lists) so the app can seed
# categories on first run. No financial data lives in these files.
!data/*_categories.json
!data/*_rules.json

# Local test media / financial docs.
*.jpg
*.jpeg
*.png
*.webp
*.pdf
*.xlsx

# Docs
DEPLOY.md
README.md
