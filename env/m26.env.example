# ============================================================================
# Company 1: M26
# Copy this to env/m26.env on the server (git-ignored) and fill in real values.
# Each company has its own copy of this file — its own database, WhatsApp number,
# invoice branding and approved users.
# ============================================================================

# ---- Database (M26's own database on the shared MySQL server) ----
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASS=change-me-to-a-long-random-password   # MUST equal MYSQL_ROOT_PASSWORD in env/db.env
DB_NAME=bookkeeper_m26

# ---- Claude (the AI) ----
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Model defaults are good; uncomment only to override.
# MODEL=claude-opus-4-8
# READ_MODEL=claude-haiku-4-5

# ---- Business details (printed on M26's invoices) ----
# Eswatini uses the Lilangeni (SZL), pegged 1:1 to the Rand; ZAR works fine, or
# set SZL if you prefer. VAT is 15% either way.
DEFAULT_CURRENCY=ZAR
BUSINESS_NAME=M26 Technologies
BUSINESS_EMAIL=info@m26technologies.co.sz
BUSINESS_PHONE=
BUSINESS_ADDRESS=
BUSINESS_VAT_NO=
BUSINESS_BANK_DETAILS=Bank name|Acc: 000000000|Branch: 000000|Ref: your invoice number

# ---- WhatsApp (M26's own number + a PERMANENT token from Meta) ----
WHATSAPP_TOKEN=paste-M26-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=paste-M26-phone-number-id
WHATSAPP_VERIFY_TOKEN=invent-a-secret-string-for-M26
# REQUIRED for production — turns on Meta signature verification.
WHATSAPP_APP_SECRET=paste-M26-app-secret

# ---- Security (REQUIRED for production) ----
# Approved WhatsApp numbers (M26 owner/staff) allowed to use the bot,
# comma-separated, country code + number, digits only.
# Example: OWNER_NUMBERS=26876000000,27821234567
OWNER_NUMBERS=
RATE_LIMIT_PER_MINUTE=20
