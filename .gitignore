# Secrets — never commit
.env

# Per-company deployment secrets: keep the .example templates, ignore the real ones
env/*.env
!env/*.env.example

# Server runtime data + database backups (never commit financial data)
data/
backups/

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Local receipt files used for testing (keep real financial docs out of git)
receipts/
*.jpg
*.jpeg
*.png
*.webp
*.pdf

# Generated report files (may contain financial data)
reports/
*.xlsx

# WhatsApp-uploaded media (real receipts)
uploads/
